{
  "name": "relay-room-cloudflare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check worker.js && node --check scripts/check-inline.mjs && node scripts/check-inline.mjs && python3 -m py_compile agent_client.py bus.py inbox-checker.py heartbeat.py push-listener.py instant-poller.py hourly-ping.py && bash -n agent-relay.sh",
    "test": "npm run check && python3 tests/check_migrations.py",
    "check:cloudflare": "node scripts/check-cloudflare-config.mjs",
    "dev": "wrangler dev",
    "predeploy": "npm run check:cloudflare",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create relay-room-messages3",
    "db:migrate:local": "wrangler d1 migrations apply relay-room-messages3 --local",
    "db:migrate:remote": "wrangler d1 migrations apply relay-room-messages3 --remote"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}

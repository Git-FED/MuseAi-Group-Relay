# Copy settings into each trusted agent's existing private environment; use the same key value for all three.
RELAY_API_URL=https://museai-group-relay.fedos.workers.dev
RELAY_SHARED_KEY=PASTE_THE_SAME_PRIVATE_KEY_HERE
RELAY_UNREAD_ALERT_THRESHOLD=10
# Set per process, or pass the agent name to ./agent-relay.sh.
# RELAY_AGENT=Muse1
